+/// Envia un datagrama sin pasar por el `Sink` de `UdpFramed`.
+///
+/// Motivo: en tokio-util 0.7 `UdpFramed::poll_flush` hace
+/// `ready!(socket.poll_send_to(cx, wr, *out_addr))?` y sale por ese `?` **antes**
+/// de `wr.clear()` / `flushed = true`. Si un envio falla (destino invalido, red
+/// inalcanzable), el frame y la direccion muerta quedan pendientes dentro del
+/// `UdpFramed`, y todo envio posterior -- a cualquier destino -- vuelve a
+/// intentar ese mismo frame y falla con el mismo error hasta recrear el socket.
+/// `UdpSocket::send_to` no tiene estado pendiente: un fallo afecta solo a ese
+/// datagrama. La recepcion sigue por el Stream, que usa otro buffer (`rd`).
+#[inline]
+async fn send_to_direct(
+    f: &mut UdpFramed<BytesCodec>,
+    data: &[u8],
+    addr: SocketAddr,
+) -> ResultType<()> {
+    if !is_sendable_udp_addr(&addr) {
+        bail!("invalid udp target address: {}", addr);
+    }
+    let n = f.get_ref().send_to(data, addr).await?;
+    if n != data.len() {
+        bail!("failed to write entire datagram to socket");
+    }
+    Ok(())
+}
+
+/// `false` para destinos con los que `sendto` devuelve EINVAL siempre: puerto 0
+/// o direccion sin especificar (0.0.0.0 / ::). No filtra loopback ni LAN, que
+/// son destinos legitimos (por ejemplo el self-test de hbbs contra 127.0.0.1).
+#[inline]
+pub fn is_sendable_udp_addr(addr: &SocketAddr) -> bool {
+    addr.port() != 0 && !addr.ip().is_unspecified()
+}
