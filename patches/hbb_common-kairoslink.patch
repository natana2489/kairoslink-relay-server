+    #[tokio::test]
+    async fn fallo_real_de_send_to_no_rompe_el_socket() {
+        let mut s = socket_local().await;
+        let err = s
+            .send_bytes_for_test(b"x", "[2800:810:1::1]:21116".parse().unwrap())
+            .await;
+        assert!(err.is_err(), "se esperaba error del SO en send_to");
+        assert_socket_sigue_usable(&mut s).await;
+    }
+
+    /// Muchos fallos seguidos tampoco degradan el socket.
+    #[tokio::test]
+    async fn muchos_fallos_seguidos_no_rompen_el_socket() {
+        let mut s = socket_local().await;
+        for _ in 0..50 {
+            let _ = s
+                .send_bytes_for_test(b"x", "190.245.223.51:0".parse().unwrap())
+                .await;
+            let _ = s
+                .send_bytes_for_test(b"x", "[2800:810:1::1]:21116".parse().unwrap())
