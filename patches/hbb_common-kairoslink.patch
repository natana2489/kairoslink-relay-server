+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    async fn socket_local() -> FramedSocket {
+        FramedSocket::new(&"127.0.0.1:0".parse::<SocketAddr>().unwrap())
+            .await
+            .unwrap()
+    }
+
+    /// El socket sigue vivo y usable: se envia a un receptor real y llega.
+    async fn assert_socket_sigue_usable(s: &mut FramedSocket) {
+        let mut rx = socket_local().await;
+        let rx_addr = rx.local_addr().unwrap();
+        s.send_bytes_for_test(b"ok", rx_addr).await.unwrap();
+        let (data, _) = rx.next_timeout(2_000).await.unwrap().unwrap();
+        assert_eq!(&data[..], b"ok");
+    }
+
+    #[test]
+    fn direcciones_no_enviables() {
+        let p = |s: &str| s.parse::<SocketAddr>().unwrap();
+        assert!(!is_sendable_udp_addr(&p("190.245.223.51:0")));
+        assert!(!is_sendable_udp_addr(&p("0.0.0.0:0")));
+        assert!(!is_sendable_udp_addr(&p("0.0.0.0:21116")));
+        assert!(!is_sendable_udp_addr(&p("[::]:21116")));
+        // Loopback y LAN si son destinos validos (self-test de hbbs, peers LAN).
+        assert!(is_sendable_udp_addr(&p("127.0.0.1:21116")));
+        assert!(is_sendable_udp_addr(&p("190.245.223.51:33000")));
+    }
+
+    #[tokio::test]
+    async fn envio_a_puerto_cero_no_rompe_el_socket() {
+        let mut s = socket_local().await;
+        let err = s
+            .send_bytes_for_test(b"x", "190.245.223.51:0".parse().unwrap())
+            .await;
+        assert!(err.is_err());
+        assert_socket_sigue_usable(&mut s).await;
+    }
+
+    #[tokio::test]
+    async fn envio_a_unspecified_no_rompe_el_socket() {
+        let mut s = socket_local().await;
+        assert!(s
+            .send_bytes_for_test(b"x", "0.0.0.0:21116".parse().unwrap())
+            .await
+            .is_err());
+        assert!(s
+            .send_bytes_for_test(b"x", "0.0.0.0:0".parse().unwrap())
+            .await
+            .is_err());
+        assert_socket_sigue_usable(&mut s).await;
+    }
+
+    /// Fallo genuino de `sendto` del SO (no filtrado por la validacion): socket
